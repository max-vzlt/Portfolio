# Copie ce fichier en `.env` et remplis les valeurs.

# Mot de passe du back-office (/admin). Obligatoire en production.
# En développement, si vide, le mot de passe est "admin".
NUXT_ADMIN_PASSWORD=

# Secret de session (32 caractères minimum). Si vide, un secret est généré
# automatiquement et sauvegardé dans data/.session-secret
NUXT_SESSION_SECRET=

# Dossier des données (base JSON + images uploadées). Par défaut : ./data
NUXT_DATA_DIR=

# URL publique du site (pour le sitemap et les balises Open Graph)
NUXT_PUBLIC_SITE_URL=https://mverzeletti.com

# --- Traduction automatique (un seul fournisseur suffit) -------------------
# 1) DeepL (recommandé, 500 000 caractères/mois gratuits) : https://www.deepl.com/pro-api
NUXT_DEEPL_API_KEY=
# 2) LibreTranslate (auto-hébergeable) : URL de l'instance + clé éventuelle
NUXT_LIBRETRANSLATE_URL=
NUXT_LIBRETRANSLATE_API_KEY=
# 3) Sans configuration, MyMemory (gratuit, limité) est utilisé.
#    Renseigner un email augmente le quota journalier.
NUXT_MYMEMORY_EMAIL=

# --- Robots IA ------------------------------------------------------------------
# Par défaut tous les robots IA peuvent lire le site. Mettre false pour bloquer
# ceux qui servent uniquement à entraîner les modèles (GPTBot, ClaudeBot, CCBot…),
# en gardant les assistants et moteurs de recherche IA (ChatGPT Search, Claude, Perplexity…).
NUXT_AI_TRAINING=true
